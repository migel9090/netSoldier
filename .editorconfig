# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[Taskfile.yml]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yaml,yml}]
indent_size = 2

[*.toml]
indent_size = 4

[Dockerfile*]
indent_size = 4

[*.tf]
indent_size = 2

[*.{sh,bash}]
indent_size = 2
