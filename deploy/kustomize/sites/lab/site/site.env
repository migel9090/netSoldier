# Site values of the lab: the simulated home LAN inside the lab VM
# (infra/ansible/roles/lab_lan builds it from this same file). These are the
# only places a site's addresses, interface names and protected devices are
# written down; nothing under deploy/kustomize/base or overlays/ carries one.
#
# Rendered into the ConfigMap `netsoldier-site` (namespaces netsoldier and
# dns) and from there into env vars, NetworkPolicy ipBlocks and the hostIP of
# the two published ports (components/site-values). Changing a value rolls
# the pods that read it (the ConfigMap name carries a content hash).

# The LAN interface on the node. netagent captures there and nowhere else.
LAN_INTERFACE=nslan0
# The household LAN (IPv4). Clients of DNS and of the web UI come from here;
# detection-engine treats it as local (LOCAL_NETWORKS).
LAN_CIDR=10.77.0.0/24
# The node's own address and MAC on the LAN. AdGuard (DNS, port 53) and the
# web UI (port 3000) are published on this address only, never on others.
NODE_LAN_IP=10.77.0.2
NODE_LAN_MAC=02:4e:53:00:00:02
# The router, pinned by both identifiers (killswitch GATEWAY_*, netagent).
GATEWAY_IP=10.77.0.1
GATEWAY_MAC=02:4e:53:00:00:01
# Devices the killswitch must never act against, besides the gateway. An
# empty list means "no auto-block": every action then waits for a human.
# The node's LAN address belongs here: in a pod the killswitch can only
# discover its own pod address, not the node's. Single addresses,
# comma separated (netagent's guard takes no CIDRs).
ALLOWLIST_IPS=10.77.0.2
ALLOWLIST_MACS=02:4e:53:00:00:02
# AdGuard's upstream resolvers (comma separated; plain IPs, tls://, https://)
# and the network they are in, for AdGuard's egress policy.
UPSTREAM_DNS=10.77.0.1
UPSTREAM_DNS_CIDR=10.77.0.1/32
# The address people open in the browser: the web UI on the node's LAN
# address. Plain HTTP until TLS is set up; cookies are then not Secure.
WEB_UI_ORIGIN=http://10.77.0.2:3000
# Pod network of the cluster (ClickHouse accepts logins from it only) and the
# address host-network pods (netagent) present to pods on this node: k3s
# routes host-to-pod traffic from the node's address on its pod subnet.
POD_CIDR=10.42.0.0/16
HOST_NETWORK_SOURCE_CIDR=10.42.0.1/32
# The abuse.ch feeds are licensed for non-commercial use only; a lab is not a
# household, so only Spamhaus DROP is fetched here.
COMMERCIAL_MODE=true
# ARP isolation by netagent. Off: the agent refuses it while the node
# forwards IPv4 on the LAN interface, and a k3s node always does (the pod
# network and the published ports need net.ipv4.ip_forward=1).
NETAGENT_ENABLE_ARP_ISOLATION=false
