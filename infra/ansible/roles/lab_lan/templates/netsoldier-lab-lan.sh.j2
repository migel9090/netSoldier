#!/bin/sh
# Managed by Ansible (infra/ansible/roles/lab_lan). Local edits are lost.
#
# The lab's simulated home LAN, entirely inside this VM:
#
#   {{ lab_lan_gateway_ns }}  {{ lab_lan_gateway_ip }} {{ lab_lan_gateway_mac }}  router: DHCP + the resolver AdGuard forwards to
{% for v in lab_lan_victims %}
#   {{ v.ns }}  DHCP client {{ v.mac }} ({{ v.hostname }})
{% endfor %}
#     \  |  /
#   {{ lab_lan_bridge }}  bridge, no uplink; the node is {{ lab_lan_node_ip }} {{ lab_lan_node_mac }} on it
#
# netagent captures on {{ lab_lan_bridge }}. AdGuard (53) and the web UI (3000) are
# published on {{ lab_lan_node_ip }} only. Nothing is forwarded between the lab LAN
# and {{ lab_lan_uplink }} (the real network) in either direction.
#
#   netsoldier-lab-lan up | down | status
#   netsoldier-lab-lan dhcp <victim-ns>     take a lease (udhcpc), print it
#   netsoldier-lab-lan release <victim-ns>  drop the address again
set -eu

BR={{ lab_lan_bridge }}
CIDR={{ lab_lan_cidr }}
UPLINK={{ lab_lan_uplink }}
PODBR={{ lab_lan_pod_bridge }}
GWNS={{ lab_lan_gateway_ns }}
CONF={{ lab_lan_config_dir }}
RUN={{ lab_lan_run_dir }}
CHAIN=NETSOLDIER-LAB
IPT="iptables -w"

no_ipv6() { # <netns|-> <ifname|all>
  if [ "$1" = - ]; then
    echo 1 >"/proc/sys/net/ipv6/conf/$2/disable_ipv6"
  else
    ip netns exec "$1" sh -c "echo 1 >/proc/sys/net/ipv6/conf/$2/disable_ipv6"
  fi
}

# port <netns> <host-side name> <mac>: a veth into the bridge, eth0 inside.
port() {
  ns=$1 host=$2 mac=$3
  ip netns list | cut -d" " -f1 | grep -qx "$ns" || ip netns add "$ns"
  mkdir -p "/etc/netns/$ns"
  [ -f "/etc/netns/$ns/resolv.conf" ] || : >"/etc/netns/$ns/resolv.conf"
  ip netns exec "$ns" sh -c 'echo 1 >/proc/sys/net/ipv6/conf/default/disable_ipv6'
  no_ipv6 "$ns" all
  if ! ip link show "$host" >/dev/null 2>&1; then
    ip link add "$host" type veth peer name eth0 netns "$ns"
  fi
  ip netns exec "$ns" ip link set eth0 address "$mac"
  no_ipv6 - "$host"
  ip link set "$host" master "$BR" up
  ip netns exec "$ns" ip link set lo up
  ip netns exec "$ns" ip link set eth0 up
}

guard_up() {
  # Lab LAN <-> pod network only, and only what kube-router's policies
  # admit there: DNAT'd queries to AdGuard and the web UI, AdGuard's queries
  # to the gateway. With br_netfilter loaded (k3s), frames bridged between
  # the lab's own ports traverse FORWARD as $BR -> $BR; they stay inside.
  $IPT -N "$CHAIN" 2>/dev/null || $IPT -F "$CHAIN"
  $IPT -A "$CHAIN" -i "$BR" -o "$BR" -j ACCEPT
  $IPT -A "$CHAIN" -i "$BR" -o "$PODBR" -j RETURN
  $IPT -A "$CHAIN" -i "$PODBR" -o "$BR" -j RETURN
  $IPT -A "$CHAIN" -i "$BR" -j DROP
  $IPT -A "$CHAIN" -o "$BR" -j DROP
  $IPT -C FORWARD -j "$CHAIN" 2>/dev/null || $IPT -I FORWARD 1 -j "$CHAIN"
  # Nothing from the real network reaches the lab LAN's addresses (the
  # node's {{ lab_lan_node_ip }} included, where DNS and the web UI are published),
  # and nothing claiming to be from the lab LAN is accepted on $UPLINK.
  for dir in -d -s; do
    $IPT -t raw -C PREROUTING -i "$UPLINK" "$dir" "$CIDR" -j DROP 2>/dev/null ||
      $IPT -t raw -I PREROUTING -i "$UPLINK" "$dir" "$CIDR" -j DROP
  done
}

guard_down() {
  for dir in -d -s; do
    while $IPT -t raw -D PREROUTING -i "$UPLINK" "$dir" "$CIDR" -j DROP 2>/dev/null; do :; done
  done
  while $IPT -D FORWARD -j "$CHAIN" 2>/dev/null; do :; done
  $IPT -F "$CHAIN" 2>/dev/null || true
  $IPT -X "$CHAIN" 2>/dev/null || true
}

up() {
  mkdir -p "$RUN"
  if ! ip link show "$BR" >/dev/null 2>&1; then
    ip link add "$BR" type bridge stp_state 0 forward_delay 0
  fi
  ip link set "$BR" address {{ lab_lan_node_mac }}
  no_ipv6 - "$BR"
  ip addr replace {{ lab_lan_node_ip }}/{{ lab_lan_prefix }} dev "$BR"
  ip link set "$BR" up

  port "$GWNS" lab-gw {{ lab_lan_gateway_mac }}
  ip netns exec "$GWNS" ip addr replace {{ lab_lan_gateway_ip }}/{{ lab_lan_prefix }} dev eth0
{% for v in lab_lan_victims %}
  port {{ v.ns }} lab-{{ v.ns }} {{ v.mac }}
{% endfor %}
  guard_up
}

down() {
  guard_down
  for ns in "$GWNS"{% for v in lab_lan_victims %} {{ v.ns }}{% endfor %}; do
    ip netns pids "$ns" 2>/dev/null | xargs -r kill 2>/dev/null || true
    ip netns del "$ns" 2>/dev/null || true
    rm -rf "/etc/netns/$ns"
  done
  ip link del "$BR" 2>/dev/null || true
}

status() {
  ip -br link show master "$BR"
  ip -br addr show dev "$BR"
  for ns in $(ip netns list | cut -d' ' -f1); do
    printf '%-6s %s\n' "$ns" "$(ip netns exec "$ns" ip -br -4 addr show dev eth0 2>/dev/null)"
  done
  $IPT -S "$CHAIN"
  $IPT -t raw -S PREROUTING | grep -F -- "$UPLINK" || true
}

victim() {
  case " {% for v in lab_lan_victims %}{{ v.ns }} {% endfor %}" in
    *" $1 "*) ;;
    *) echo "unknown victim namespace: $1" >&2; exit 2 ;;
  esac
}

hostname_of() {
  case $1 in
{% for v in lab_lan_victims %}
    {{ v.ns }}) echo {{ v.hostname }} ;;
{% endfor %}
  esac
}

dhcp() {
  victim "$1"
  ip netns exec "$1" ip -4 addr flush dev eth0
  ip netns exec "$1" busybox udhcpc -i eth0 -f -q -n -t 5 -T 2 -A 2 \
    -x "hostname:$(hostname_of "$1")" -s "$CONF/udhcpc.sh"
  ip netns exec "$1" ip -br -4 addr show dev eth0
}

release() {
  victim "$1"
  ip netns exec "$1" ip -4 addr flush dev eth0
  : >"/etc/netns/$1/resolv.conf"
}

case ${1:-} in
  up) up ;;
  down) down ;;
  status) status ;;
  dhcp) dhcp "${2:?victim namespace}" ;;
  release) release "${2:?victim namespace}" ;;
  *) echo "usage: $0 up|down|status|dhcp <ns>|release <ns>" >&2; exit 2 ;;
esac
