# ── Secrets safety net ──
# SOPS-ENCRYPTED files ARE committed; plaintext secrets never.
.env
.env.*
!.env.example
*.pem
*.key
age.agekey
keys.txt
*.dec
*.dec.*
kubeconfig
*.kubeconfig

# ── Runtime data (inventory DBs, captures, logs) ──
# PCAP corpus is fetched via manifest (see detections/pcap-corpus), never committed.
*.db
*.sqlite
*.sqlite3
*.log
*.pcap
*.pcapng

# ── Local-only working context (used by AI tooling, never committed) ──
context/

# ── OS / editors ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
