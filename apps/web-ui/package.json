{
  "name": "netsoldier-web-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.17"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "svelte-kit sync && vitest run",
    "test:e2e": "vite build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-node": "^6.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
