# The lab reads ~/.config/netsoldier-lab/lab.auto.tfvars (never this file).
# infra/lab/proxmox-token.sh writes the first two lines; everything else has a
# default in variables.tf and is shown here only to document what can be set.

proxmox_endpoint  = "https://192.168.1.40:8006/"
proxmox_api_token = "terraform@pve!netsoldier-lab=<written by infra/lab/proxmox-token.sh>"

# proxmox_node       = "pve"
# pool_id            = "netsoldier-lab"
# image_datastore_id = "local"
# disk_datastore_id  = "scratch2"
# network_bridge     = "vmbr0"

# vm_id         = 110
# vm_name       = "netsoldier-soc"
# cpu_cores     = 4
# memory_mib    = 8192
# disk_size_gib = 60

# ipv4_address      = "192.168.1.61/24"
# ipv4_gateway      = "192.168.1.1"
# dns_servers       = ["192.168.1.1"]
# ssh_allowed_cidrs = []   # empty: the VM's subnet
# api_allowed_cidrs = []   # empty: only the machine running Ansible
