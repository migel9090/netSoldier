# netSoldier lite: detection-engine.
#
# Polls AdGuard's query log, matches names against the threat feeds
# (threat-intel-sync) and the site's own list (/etc/netsoldier/
# local-indicators.txt), resolves the client to a device through
# device-inventory, keeps alerts and its delivery outbox in SQLite and
# delivers signed detections to the killswitch with the ingest token. No
# ClickHouse in this profile: sensor ingest and feedback persistence are off.
# Internal network only, no capability, nothing published.
[Unit]
Description=netSoldier lite: detection-engine
PartOf=netsoldier.target
After=netsoldier-adguard.service netsoldier-threat-intel-sync.service
After=netsoldier-device-inventory.service netsoldier-killswitch.service

[Container]
ContainerName=netsoldier-detection-engine
Image=ghcr.io/migel9090/detection-engine:main
Network=netsoldier-internal.network:ip=10.231.47.12
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Volume=netsoldier-detection-engine-data.volume:/var/lib/detection-engine
Volume=/etc/netsoldier/local-indicators.txt:/etc/netsoldier/local-indicators.txt:ro,z
Environment=LISTEN_ADDR=:8080
Environment=DB_PATH=/var/lib/detection-engine/detection-engine.db
Environment=ADGUARD_URL=http://netsoldier-adguard:3000
Environment=ADGUARD_USER=netsoldier
Environment=THREAT_INTEL_URL=http://netsoldier-threat-intel-sync:8083
Environment=THREATLIST_PATH=/etc/netsoldier/local-indicators.txt
Environment=DEVICE_INVENTORY_URL=http://netsoldier-device-inventory:8081
Environment=WEBHOOK_URL=http://netsoldier-killswitch:8084/evaluate
# There is no OpenTelemetry collector in this profile. Sampling nothing
# means the exporter never has anything to send (and never dials the
# default collector address).
Environment=OTEL_TRACES_SAMPLER=always_off
Environment=GOMEMLIMIT=72MiB
Secret=netsoldier-adguard-password,type=env,target=ADGUARD_PASSWORD
Secret=netsoldier-detection-api-key,type=env,target=DETECTION_API_KEY
Secret=netsoldier-device-api-key,type=env,target=DEVICE_API_KEY
Secret=netsoldier-webhook-secret,type=env,target=WEBHOOK_SECRET
Secret=netsoldier-killswitch-ingest-token,type=env,target=WEBHOOK_TOKEN
# LOCAL_NETWORKS, from netsoldier.conf.
EnvironmentFile=/etc/netsoldier/env/detection-engine.env
PidsLimit=256
PodmanArgs=--memory=96m --memory-swap=96m
StopTimeout=20
Label=app=netsoldier

[Service]
Environment=XDG_RUNTIME_DIR=/run/netsoldier/podman
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=netsoldier.target
