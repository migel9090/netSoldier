# ── Go ──
bin/
*.test
coverage.out
coverage.html

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/

# ── Node / SvelteKit ──
node_modules/
.svelte-kit/
apps/web-ui/build/
.pnpm-store/
npm-debug.log*
pnpm-debug.log*

# ── Terraform ──
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfplan

# ── Ansible ──
*.retry

# ── Secrets safety net ──
# SOPS-ENCRYPTED files ARE committed; plaintext secrets never.
.env
.env.*
!.env.example
*.pem
*.key
age.agekey
keys.txt
*.dec
*.dec.*
kubeconfig
*.kubeconfig

# ── Runtime data (inventory DBs, captures, logs) ──
# Captures are never committed: the detection corpus is regenerated by
# detections/pcap-corpus/gen_corpus.py, and real-world captures are fetched
# from the pinned manifest into detections/pcap-corpus/external/.
*.db
*.sqlite
*.sqlite3
*.log
*.pcap
*.pcapng
detections/pcap-corpus/external/
# Exception: tiny loopback/synthetic golden pcaps for the JA4 test
!deploy/docker/zeek/test/pcaps/*.pcap

# ── Local-only working context (used by AI tooling, never committed) ──
context/

# ── OS / editors ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

apps/detection-engine/detection-engine
apps/device-inventory/device-inventory
apps/killswitch-controller/killswitch-controller
apps/threat-intel-sync/threat-intel-sync
